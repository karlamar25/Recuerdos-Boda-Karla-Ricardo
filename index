<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#5c6b49">

    <title>Karla & Ricardo | Captura el amor</title>

    <link rel="stylesheet" href="styles.css">
</head>

<body>

    <main class="pagina">

        <header class="encabezado">
            <h1>Karla <span>&</span> Ricardo</h1>

            <p class="fecha">
                Diciembre 5, 2026
            </p>
        </header>

        <div class="camara" aria-hidden="true">

            <svg viewBox="0 0 220 160"
                 xmlns="http://www.w3.org/2000/svg"
                 fill="none">

                <g stroke="currentColor"
                   stroke-width="2.5"
                   stroke-linecap="round"
                   stroke-linejoin="round">

                    <path d="M28 42h35l9-12h32l10 12h37c6 0 10 4 10 10v67c0 6-4 10-10 10H28c-6 0-10-4-10-10V52c0-6 4-10 10-10Z"/>

                    <path d="M73 30v-9h36v9"/>

                    <path d="M22 60h143"/>

                    <circle cx="98" cy="83" r="34"/>
                    <circle cx="98" cy="83" r="25"/>
                    <circle cx="98" cy="83" r="15"/>
                    <circle cx="98" cy="83" r="6"/>

                    <path d="M31 35v-8h18v8"/>
                    <path d="M140 35v-8h18v8"/>

                    <ellipse cx="40" cy="27" rx="9" ry="3.5"/>
                    <ellipse cx="149" cy="27" rx="9" ry="3.5"/>

                </g>

            </svg>

        </div>

        <p class="mensaje">
            ¡Comparte con nosotros las fotografías y videos
            de este día tan especial!
        </p>

        <div class="separador"></div>

        <button
            class="boton-subida"
            id="seleccionar-archivos"
            type="button">

            <svg viewBox="0 0 52 52"
                 fill="none"
                 aria-hidden="true">

                <path
                    d="M15 36H12a9 9 0 0 1-1-18 15 15 0 0 1 29-1 10 10 0 0 1 1 19h-4"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"/>

                <path
                    d="M26 43V23m0 0-8 8m8-8 8 8"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"/>

            </svg>

            <span class="texto-boton">

                <strong>
                    SELECCIONA FOTOS Y VIDEOS
                </strong>

                <small>
                    PUEDES SELECCIONAR VARIOS ARCHIVOS
                </small>

            </span>

        </button>

        <input
            id="archivos"
            type="file"
            accept="image/*,video/*"
            multiple
            hidden>

        <p class="agradecimiento">
            Gracias por ser parte de nuestra historia
        </p>

        <div class="monograma" aria-hidden="true">

            <span class="letra-k">K</span>
            <span class="letra-r">R</span>

            <span class="flor">✿</span>

        </div>

        <p id="estado-archivos" aria-live="polite"></p>

    </main>

    <script src="script.js"></script>

</body>
</html>
